# Copy to .env.local and fill in values.
# Required for the app to boot (see src/lib/supabase/env.ts).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alternative name supported by the app:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for server-side admin/cron routes and service actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Recommended for auth redirects and absolute links in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional integrations ---

# AI chat / agents (Groq preferred; OpenAI as fallback)
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=

# Text-to-speech
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Vercel cron endpoints (local testing: curl with Authorization header)
# CRON_SECRET=

# Platform admin / impersonation
# PLATFORM_ADMIN_EMAILS=admin@example.com
# IMPERSONATION_SECRET=

# Slack connector (@vercel/connect)
# SLACK_CONNECTOR=

# Webhooks
# AI_CREDITS_WEBHOOK_SECRET=

# SEO
# GOOGLE_SITE_VERIFICATION=

# Mobile dev helper (/dev/mobile)
# MOBILE_DEV_HOST=
